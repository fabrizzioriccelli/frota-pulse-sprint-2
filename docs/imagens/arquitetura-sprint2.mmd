flowchart TB
    subgraph E["Entradas (data/raw e data/telemetria)"]
        direction LR
        E1["CSV<br/>cadastro, cartão-combustível,<br/>lançamentos do ERP"]
        E2["TXT<br/>extratos da tag de pedágio"]
        E3["JSON<br/>ordens de serviço, multas,<br/>quilometragem, NF-e"]
        E4["ESP32 / Wokwi<br/>telemetria em CSV"]
        E1 ~~~ E2 ~~~ E3 ~~~ E4
    end
    subgraph P["Processamento (src/frota_pulse)"]
        direction LR
        P1["1 Ingestão<br/>ingestao.py"] --> P2["2 Normalização<br/>normalizacao.py"]
        P2 --> P3["3 Qualidade<br/>qualidade.py"]
        P3 --> P4["4 Integração<br/>integracao.py"]
    end
    subgraph A["Análise e diagnóstico"]
        direction LR
        A1["5 Indicadores<br/>indicadores.py"] --> A2["6 Benchmark e gaps<br/>benchmark.py"]
        A2 --> A3["7 Regras<br/>diagnostico.py"]
        A2 --> A4["8 Árvore de decisão<br/>modelo.py"]
        A3 --> A5["9 Regras x modelo"]
        A4 --> A5
    end
    subgraph S["Armazenamento local e saídas"]
        direction LR
        S1[("data/processed<br/>bases tratadas,<br/>quarentena")]
        S2["outputs/reports<br/>qualidade, benchmark,<br/>diagnóstico"]
        S3["outputs/charts<br/>outputs/predictions"]
        S1 ~~~ S2 ~~~ S3
    end
    E --> P
    P --> A
    P -. "bases tratadas e relatório de qualidade" .-> S
    A --> S
